import java.util.Arrays;

public class Main {
    public static void main(String[] args) {
        String[] words = {"java", "programming", "code", "university", "lab"};

        if (words.length == 0) {
            System.out.println("Масив порожній.");
            return;
        }

        double sum = 0;
        for (int i = 0; i < words.length; i++) {
            sum += words[i].length();
        }

        double avg = sum / words.length;
        System.out.println("Середня довжина: " + avg);

        int shortCount = 0;
        int longCount = 0;
        for (int i = 0; i < words.length; i++) {
            if (words[i].length() < avg) {
                shortCount++;
            } else if (words[i].length() > avg) {
                longCount++;
            }
        }

        String[] shortWords = new String[shortCount];
        String[] longWords = new String[longCount];

        int shortIndex = 0;
        int longIndex = 0;

        for (int i = 0; i < words.length; i++) {
            if (words[i].length() < avg) {
                shortWords[shortIndex++] = words[i];
            } else if (words[i].length() > avg) {
                longWords[longIndex++] = words[i];
            }
        }

        System.out.println("Рядки, менші за середню довжину: " + Arrays.toString(shortWords));
        System.out.println("Рядки, більші за середню довжину: " + Arrays.toString(longWords));
    }
}
